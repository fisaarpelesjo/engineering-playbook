{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "updated_at", "active_workstream", "current_branch", "current_phase", "status", "active_specification", "active_plan", "active_tasks", "active_task", "validation", "blockers", "next_actions"],
  "properties": {
    "schema_version": {"type": "string"},
    "updated_at": {"type": "string"},
    "active_workstream": {"type": ["string", "null"], "pattern": "^WS-[0-9]{3}$"},
    "current_branch": {"type": "string"},
    "current_phase": {"type": "string"},
    "status": {"type": "string", "enum": ["proposed", "clarified", "planned", "ready", "in_progress", "review", "changes_requested", "verified", "converged", "done", "archived", "blocked", "paused", "abandoned", "superseded"]},
    "active_specification": {"type": ["string", "null"]},
    "active_plan": {"type": ["string", "null"]},
    "active_tasks": {"type": ["string", "null"]},
    "active_task": {"type": ["string", "null"], "pattern": "^T[0-9]{3,5}$"},
    "last_checkpoint": {"type": ["string", "null"]},
    "no_spec_reason": {
      "type": ["string", "null"],
      "description": "Why this slice changes code without an active specification claiming it (FR-014, T213). A declared escape, not silence: the sentence travels in the pull request and a reviewer reads it. Fewer than five words is refused."
    },
    "last_verified_commit": {
      "type": ["string", "null"],
      "description": "Read cache of the signed verdict, for a human reading this file. Not the verdict and not a gate (spec 003 FR-007, issue #24): it is written by a commit that changes the content it names, so it cannot be required to still cover HEAD. The verdict is the attestation the quality workflow signs; `attest verify` reads it."
    },
    "last_verified_tree": {
      "type": ["string", "null"],
      "description": "Read cache of the signed verdict, as a git tree id. Same status as last_verified_commit: reported when stale, gating nothing. A derived project declaring `ci: none` has no workflow identity and keeps the commit/ancestry mechanism instead (FR-020)."
    },
    "validation": {
      "type": "object",
      "required": ["passed", "failed", "not_run"],
      "properties": {
        "passed": {"type": "array", "items": {"type": "string"}},
        "failed": {"type": "array", "items": {"type": "string"}},
        "not_run": {"type": "array", "items": {"type": "string"}}
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "unit_status": {"type": "string", "enum": ["WORKING", "READY_FOR_REVIEW", "CHANGES_REQUESTED", "PASS", "OWNER_DECISION_REQUIRED", "STOPPED"]},
    "updated_at_local": {"type": "string"},
    "timezone": {"type": "string"},
    "authorized_scope": {"type": ["string", "null"]},
    "owner_authorization_required": {"type": "boolean"},
    "issue": {"type": "integer", "minimum": 1}
  }
}
